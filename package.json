{
  "name": "projects-switch",
  "displayName": "Projects Switch",
  "description": "Quickly discover and switch Git projects from the status bar.",
  "version": "1.0.1",
  "publisher": "sunzhongyi",
  "repository": {
    "type": "git",
    "url": "https://github.com/joisun/projects-switch.git"
  },
  "homepage": "https://github.com/joisun/projects-switch#readme",
  "bugs": {
    "url": "https://github.com/joisun/projects-switch/issues"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "project",
    "switcher",
    "workspace",
    "git"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "icons": {
      "project-switcher-project": {
        "description": "Switch projects",
        "default": {
          "fontPath": "./assets/project-switcher-myna.woff",
          "fontCharacter": "\\0041"
        }
      }
    },
    "commands": [
      {
        "command": "projectsSwitch.switchProject",
        "title": "Switch Project",
        "category": "Projects Switch",
        "icon": "$(project-switcher-project)"
      },
      {
        "command": "projectsSwitch.refreshProjects",
        "title": "Refresh Projects",
        "category": "Projects Switch",
        "icon": "$(refresh)"
      },
      {
        "command": "projectsSwitch.addProject",
        "title": "Add Project...",
        "category": "Projects Switch",
        "icon": "$(folder-opened)"
      }
    ],
    "keybindings": [
      {
        "key": "alt+p",
        "command": "projectsSwitch.switchProject"
      },
      {
        "key": "tab",
        "command": "workbench.action.quickOpenSelectNext",
        "when": "inQuickOpen && projectsSwitch.quickPickVisible"
      },
      {
        "key": "shift+tab",
        "command": "workbench.action.quickOpenSelectPrevious",
        "when": "inQuickOpen && projectsSwitch.quickPickVisible"
      }
    ],
    "configuration": {
      "title": "Projects Switch",
      "properties": {
        "projectsSwitch.projects.scanRoots": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Absolute directories to scan for Git projects. Environment variables are supported with `$NAME`, `${NAME}`, `${env:NAME}`, and `%NAME%` syntax. The expanded value must be an absolute directory."
        },
        "projectsSwitch.projects.excludes": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/out/**",
            "**/coverage/**",
            "**/.next/**",
            "**/.nuxt/**",
            "**/.output/**",
            "**/target/**",
            "**/.cache/**",
            "**/.venv/**",
            "**/venv/**",
            "**/__pycache__/**"
          ],
          "markdownDescription": "Glob patterns excluded from project discovery. Patterns are matched relative to each scan root."
        },
        "projectsSwitch.projects.maxDepth": {
          "type": "number",
          "scope": "machine",
          "default": 4,
          "minimum": 0,
          "maximum": 20,
          "markdownDescription": "Maximum directory depth to scan. Each scan root is depth `0`."
        },
        "projectsSwitch.projects.scanOnStartup": {
          "type": "boolean",
          "scope": "machine",
          "default": true,
          "markdownDescription": "Refresh the cached project list in the background when Projects Switch starts."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap",
    "watch": "pnpm run build -- --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "vscode:prepublish": "pnpm run check && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@types/vscode": "1.99.1",
    "esbuild": "^0.25.9",
    "minimatch": "^10.0.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
